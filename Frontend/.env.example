# Public Frontend config. Copy this file to .env and edit values as needed.
# Everything here ends up in the JS bundle — do NOT put secrets here.

# Base URL of the Inventory Backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# UI environment label — shown in the topbar/footer env chip.
# One of: dev | staging | prod
VITE_APP_ENV=dev
