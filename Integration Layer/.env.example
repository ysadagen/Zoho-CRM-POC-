# ----------------------------------------------------------------------------
# Integration Layer (.env.example)
#
# Copy this file to `.env` and fill in real values for your local machine.
# `.env` is gitignored. Never commit secrets.
#
# Every variable listed here must exist in `app/core/config.py` (Settings).
# Add a variable here in the same commit where you add it to Settings.
# ----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------

# One of: dev | staging | prod. Controls log format (console vs JSON) and
# whether /docs is exposed.
APP_ENV=dev

# Standard log levels: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# Host and port the uvicorn dev server binds to. Use a different port than
# the Backend so both services can run side by side locally.
APP_HOST=0.0.0.0
APP_PORT=8001


# --- Database (PostgreSQL, async) -------------------------------------------

# Connection string for the integration database. Owns Zoho tokens, CRM
# mappings, sync logs, idempotency keys, and webhook events.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/integration_db

# Separate database for pytest. Schema dropped/recreated per test run.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/integration_test_db


# --- Inbound auth (Backend → Integration Layer) -----------------------------

# Shared secret required in the X-Internal-API-Key header on all /sync and
# /admin routes. MUST match the Backend's INTEGRATION_LAYER_API_KEY value.
INTERNAL_API_KEY=change-me-shared-with-backend


# --- Zoho CRM (outbound) ----------------------------------------------------

# Zoho accounts domain — the data centre your CRM lives in.
# Examples: https://accounts.zoho.in | https://accounts.zoho.com | .eu | .com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Zoho API base URL — must match the same data centre as ZOHO_ACCOUNTS_URL.
# Examples: https://www.zohoapis.in/crm/v8 | https://www.zohoapis.com/crm/v8
ZOHO_API_BASE_URL=https://www.zohoapis.in/crm/v8

# OAuth client credentials from the Zoho API Console (Self Client or
# Server-Based application).
ZOHO_CLIENT_ID=replace-with-zoho-client-id
ZOHO_CLIENT_SECRET=replace-with-zoho-client-secret

# Bootstrap refresh token. Generated once via the Zoho OAuth flow and used
# only on first run; afterwards the live value is persisted in zoho_tokens.
ZOHO_REFRESH_TOKEN=replace-with-zoho-refresh-token


# --- Zoho webhooks (inbound) ------------------------------------------------

# HMAC secret used to verify the signature on inbound Zoho webhook requests.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZOHO_WEBHOOK_SECRET=change-me-to-a-long-random-string


# --- Outbound HTTP behaviour ------------------------------------------------

# Per-request timeout (seconds) for calls to Zoho.
HTTP_TIMEOUT_SECONDS=10

# Maximum retry attempts on 5xx / connection errors. 4xx are never retried
# (except 401 once after token refresh, and 429 honouring Retry-After).
HTTP_MAX_RETRIES=3

# Base for exponential backoff between retries (milliseconds). Jitter is
# applied on top of this in the client.
HTTP_BACKOFF_BASE_MS=200


# --- Idempotency ------------------------------------------------------------

# How long an Idempotency-Key + payload pair is remembered (hours). Replays
# within this window return the cached response instead of re-calling Zoho.
IDEMPOTENCY_TTL_HOURS=24
