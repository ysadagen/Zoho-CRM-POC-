# ----------------------------------------------------------------------------
# Backend (.env.example)
#
# Copy this file to `.env` and fill in real values for your local machine.
# `.env` is gitignored. Never commit secrets.
#
# Every variable listed here must exist in `app/core/config.py` (Settings).
# Add a variable here in the same commit where you add it to Settings.
# ----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------

# One of: dev | staging | prod. Controls log format (console vs JSON) and
# whether /docs is exposed.
APP_ENV=dev

# Standard log levels: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# Host and port the uvicorn dev server binds to.
APP_HOST=0.0.0.0
APP_PORT=8000


# --- Database (PostgreSQL, async) -------------------------------------------

# Connection string for the main inventory database.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db

# Separate database used by the pytest suite. Schema is dropped/recreated
# every test run. MUST point at a different DB than DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_test_db


# --- Authentication (JWT) ---------------------------------------------------

# Used to sign access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# HS256 is fine for a single-issuer JWT. Don't change unless you know why.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60


# --- Integration Layer (outbound) -------------------------------------------

# Base URL of the Integration Layer service. The Backend calls this for all
# Zoho sync. Never call Zoho directly from the Backend.
INTEGRATION_LAYER_BASE_URL=http://localhost:8001

# Shared secret sent to the Integration Layer in the X-Internal-API-Key header.
# MUST match the Integration Layer's INTERNAL_API_KEY value.
INTEGRATION_LAYER_API_KEY=change-me-shared-with-integration-layer

# HTTP timeout (seconds) for calls to the Integration Layer.
INTEGRATION_LAYER_TIMEOUT_SECONDS=10


# --- CORS -------------------------------------------------------------------

# Comma-separated list of origins allowed by the React frontend.
# Use exact origins in prod; "*" only acceptable in local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173
