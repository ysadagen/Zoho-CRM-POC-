    {
      "name": "Stock movements",
      "item": [
        {
          "name": "GET /stock-movements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/stock-movements?limit=25&offset=0",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "stock-movements"],
              "query": [
                { "key": "limit", "value": "25" },
                { "key": "offset", "value": "0" },
                { "key": "item_id", "value": "{{item_id}}", "disabled": true },
                { "key": "direction", "value": "IN", "disabled": true },
                { "key": "reason", "value": "PURCHASE", "disabled": true },
                { "key": "date_from", "value": "2026-01-01", "disabled": true },
                { "key": "date_to", "value": "2026-12-31", "disabled": true }
              ]
            },
            "description": "Read the append-only audit ledger. Filters: item_id, direction (IN/OUT), reason (PURCHASE/SALE/ADJUSTMENT), date_from/date_to (inclusive on both ends).\n\nThe ledger is **append-only** - there is no PATCH or DELETE on movements, ever."
          }
        },
        {
          "name": "POST /stock-movements/adjustments",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"{{item_id}}\",\n  \"direction\": \"IN\",\n  \"quantity\": \"25\",\n  \"remarks\": \"Recount correction - line B\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/stock-movements/adjustments",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "stock-movements", "adjustments"]
            },
            "description": "Manual adjustment. `remarks` is required - it's the accountability gate.\n\nErrors:\n- 404 ITEM_NOT_FOUND\n- 409 INSUFFICIENT_STOCK - OUT adjustment would push stock below zero.\n- 422 - Pydantic validation."
          }
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "item": [
        {
          "name": "POST /purchase-orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.collectionVariables.set('po_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_id\": \"{{vendor_id}}\",\n  \"expected_delivery_date\": \"2026-07-15\",\n  \"notes\": \"Initial stock-up\",\n  \"items\": [\n    {\n      \"item_id\": \"{{item_id}}\",\n      \"quantity\": \"100\",\n      \"unit_price\": \"45.00\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/purchase-orders",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "purchase-orders"]
            },
            "description": "Create a DRAFT purchase order.\n\nPricing: if `unit_price` is omitted on a line, the service looks up the most recent active vendor_item_term and uses `rate * (1 - discount_percent/100)` quantized to 2 dp.\n\nErrors:\n- 404 VENDOR_NOT_FOUND / ITEM_NOT_FOUND (also for inactive)\n- 409 DUPLICATE_LINE_ITEM\n- 422 PRICE_UNAVAILABLE (no explicit price and no vendor term)"
          }
        },
        {
          "name": "GET /purchase-orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/purchase-orders?limit=25&offset=0",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "purchase-orders"],
              "query": [
                { "key": "limit", "value": "25" },
                { "key": "offset", "value": "0" },
                { "key": "vendor_id", "value": "{{vendor_id}}", "disabled": true },
                { "key": "status", "value": "DRAFT", "disabled": true },
                { "key": "date_from", "value": "2026-01-01", "disabled": true },
                { "key": "date_to", "value": "2026-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET /purchase-orders/{po_id}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/purchase-orders/{{po_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "purchase-orders", "{{po_id}}"]
            }
          }
        },
        {
          "name": "POST /purchase-orders/{po_id}/receive",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/purchase-orders/{{po_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "purchase-orders", "{{po_id}}", "receive"]
            },
            "description": "Receive the PO - transactionally:\n1. Increments items.stock_quantity for each line\n2. Inserts one stock_movements row per line (IN, PURCHASE)\n3. Flips status to RECEIVED, stamps received_date=today\n\nErrors:\n- 404 PURCHASE_ORDER_NOT_FOUND\n- 409 PO_NOT_DRAFT - already received (state-boundary idempotency)"
          }
        }
      ]
