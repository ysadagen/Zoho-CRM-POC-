    {
      "name": "Vendor terms",
      "item": [
        {
          "name": "POST /vendors/{vendor_id}/terms",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.collectionVariables.set('term_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"{{item_id}}\",\n  \"rate\": \"150.00\",\n  \"discount_percent\": \"5.00\",\n  \"effective_from\": \"2026-01-01\",\n  \"effective_to\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/vendors/{{vendor_id}}/terms",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "vendors", "{{vendor_id}}", "terms"]
            },
            "description": "Create a pricing term. Returns 404 on missing vendor/item, 409 OVERLAPPING_TERMS if an active term already covers any part of the date range."
          }
        },
        {
          "name": "GET /vendors/{vendor_id}/terms",
          "request": {
            "method": "GET",
