{
  "info": {
    "_postman_id": "8b1c5a90-2b9a-4f4f-9b30-1ea4d3a6f0b1",
    "name": "Inventory Backend",
    "description": "All 37 endpoints exposed by the Inventory Backend (Phases 1-8).\n\nQuick start:\n1. Run the Auth > Register call once.\n2. Run Auth > Login - the test script stores the token in {{access_token}} so every other request inherits the Bearer header.\n3. From there, exercise any folder. Variables like {{item_id}}, {{vendor_id}} etc. are populated by their corresponding Create requests via the test scripts.\n\nThe collection-level Authorization is set to Bearer Token {{access_token}}; individual endpoints override this only when they must be unauthenticated (Auth/* and Probes/*).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_prefix",
      "value": "/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "item_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendor_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "term_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "po_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "so_id",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Empty top-level pre-request hook; per-folder scripts handle anything specific."
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Probes",
      "item": [
        {
          "name": "GET /health (liveness)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Returns 200 if the Python process is running. Does NOT check downstream dependencies — use /ready for that. Wire to k8s livenessProbe."
          }
        },
        {
          "name": "GET /ready (readiness)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ready",
              "host": ["{{base_url}}"],
              "path": ["ready"]
            },
            "description": "Readiness probe. Pings the DB with SELECT 1 under a 1-second timeout.\n\nReturns:\n- 200 {\"status\":\"ready\"} when the DB is reachable.\n- 503 with the project error envelope (code: DB_UNAVAILABLE) when it isn't.\n\nWire to k8s readinessProbe so traffic routes away from a pod whose DB is down."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect(pm.response.code).to.equal(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('user_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@example.com\",\n  \"full_name\": \"Test Operator\",\n  \"password\": \"correct-horse-battery-staple\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "register"]
            },
            "description": "Register a new user. Returns 201 with the full user record.\n\nErrors:\n- 409 EMAIL_ALREADY_REGISTERED - the email is already in use.\n- 422 - Pydantic validation (invalid email, password too short, etc.)."
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.expect(pm.response.code).to.equal(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('user_id', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@example.com\",\n  \"password\": \"correct-horse-battery-staple\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "auth", "login"]
            },
            "description": "Authenticate. Returns 200 with `{access_token, token_type, expires_in, user}`. The test script stashes the token in {{access_token}}.\n\n`expires_in` is the token lifetime in seconds (default 3600 = 1 hour, configurable via ACCESS_TOKEN_EXPIRE_MINUTES). There is no /refresh endpoint — when this lapses, redirect to login.\n\nErrors:\n- 401 INVALID_CREDENTIALS - returned for both unknown email and wrong password (no enumeration leak)."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users (admin only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users?limit=25&offset=0",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users"],
              "query": [
                { "key": "limit", "value": "25" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "List all users. Admin-only.\n\nErrors:\n- 401 MISSING_TOKEN - no/invalid bearer.\n- 403 ADMIN_REQUIRED - non-admin caller."
          }
        },
        {
          "name": "GET /users/{user_id}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", "{{user_id}}"]
            },
            "description": "Return one user.\n\nA non-admin caller can only fetch their own record; requests for any other id return **404 USER_NOT_FOUND** (not 403) to prevent id enumeration."
          }
        },
        {
          "name": "PATCH /users/{user_id}",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", "{{user_id}}"]
            },
            "description": "Partial update.\n\n- Self may update own full_name.\n- Admin may update anyone's full_name, is_active, is_admin.\n- Non-admin probing another user's id returns 404 (id enumeration guard).\n- Non-admin setting is_active or is_admin returns 403 ADMIN_REQUIRED."
          }
        },
        {
          "name": "DELETE /users/{user_id} (admin only, soft)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "users", "{{user_id}}"]
            },
            "description": "Soft-deactivate a user. Returns 204 (idempotent on already-inactive).\n\nErrors:\n- 404 USER_NOT_FOUND\n- 409 CANNOT_DEACTIVATE_SELF - admin tried to deactivate their own account."
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "POST /items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.collectionVariables.set('item_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"BOT-1L-001\",\n  \"name\": \"1L Bottle (Round)\",\n  \"type\": \"FINISHED\",\n  \"category\": \"Bottle\",\n  \"unit_of_measure\": \"pcs\",\n  \"unit_price\": \"45.00\",\n  \"stock_quantity\": \"0\",\n  \"reorder_threshold\": \"100\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/items",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "items"]
            },
            "description": "Create an item. Returns 201 with a **minimal** envelope (id, sku, name, created_at) - intentional deviation from REST convention; see ItemCreated docstring.\n\nUse GET /items/{id} for the full record with stock figures and computed status.\n\nErrors:\n- 409 DUPLICATE_SKU\n- 422 - Pydantic validation."
          }
        },
        {
          "name": "GET /items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/items?limit=25&offset=0",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "items"],
              "query": [
                { "key": "limit", "value": "25" },
                { "key": "offset", "value": "0" },
                { "key": "type", "value": "FINISHED", "disabled": true },
                { "key": "category", "value": "Bottle", "disabled": true },
                { "key": "search", "value": "1L", "disabled": true }
              ]
            },
            "description": "Paginated list, newest first. Filters: type (RAW/FINISHED), category (exact), search (case-insensitive over SKU + name)."
          }
        },
        {
          "name": "GET /items/{item_id}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/items/{{item_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "items", "{{item_id}}"]
            },
            "description": "Return one item with computed `status` (IN_STOCK / LOW_STOCK / NO_STOCK).\n\nErrors:\n- 404 ITEM_NOT_FOUND"
          }
        },
        {
          "name": "PATCH /items/{item_id}",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"1L Bottle (Round, Revised)\",\n  \"reorder_threshold\": \"150\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/items/{{item_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "items", "{{item_id}}"]
            },
            "description": "Partial update. **sku**, **type**, and **stock_quantity** are NOT patchable here - stock changes go through the stock-movement ledger (Phase 6+)."
          }
        }
      ]
    },
