# ----------------------------------------------------------------------------
# Intelligence service (.env.example)
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# This service SHARES the database with the Backend (reads CRM data, owns the
# scoring tables) and validates the Backend's JWTs — so DATABASE_URL and
# JWT_SECRET_KEY MUST match the Backend's values.
# ----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
# 8000 = Backend, 8001 = Integration Layer, 8002 = Intelligence.
APP_PORT=8002

# --- Database (shared with the Backend) -------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_test_db

# --- Authentication (JWT) — MUST match the Backend --------------------------
JWT_SECRET_KEY=change-me-to-match-the-backend
JWT_ALGORITHM=HS256

# --- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
