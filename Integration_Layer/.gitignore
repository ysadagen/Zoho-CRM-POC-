# Secrets — never commit. The repo root .gitignore also covers these; this
# local copy is belt-and-braces for a service that holds Zoho credentials.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
